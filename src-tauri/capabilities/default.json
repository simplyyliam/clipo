{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for Clipo windows",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "global-shortcut:default",
    "autostart:default"
  ]
}
